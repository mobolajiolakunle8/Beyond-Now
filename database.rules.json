{
  "rules": {
    ".read": false,
    ".write": false,

    "site": {
      ".read": true,
      ".write": "auth != null"
    },

    "media": {
      ".read": true,
      ".write": "auth != null"
    },

    "articles": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "admins": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "users": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid == $uid || auth.token.email == 'beyondnow.ng@gmail.com')"
      }
    },

    "threads": {
      ".read": "auth != null",
      "$threadId": {
        ".read": "auth != null && (auth.uid == $threadId || auth.token.email == 'beyondnow.ng@gmail.com')",
        ".write": "auth != null && (auth.uid == $threadId || auth.token.email == 'beyondnow.ng@gmail.com')"
      }
    },

    "storySubmissions": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.token.email == 'beyondnow.ng@gmail.com')",
        ".write": "auth != null && (auth.uid == $uid || auth.token.email == 'beyondnow.ng@gmail.com')"
      }
    }
  }
}
