{
  "rules": {
    ".read": false,
    ".write": false,

    "site": {
      ".read": true,
      "$docId": {
        ".write": "auth != null && (auth.token.email == 'beyondnow.ng@gmail.com' || root.child('admins').child(auth.uid).exists())"
      }
    },

    "media": {
      ".read": true,
      "$mediaId": {
        ".write": "auth != null && (auth.token.email == 'beyondnow.ng@gmail.com' || root.child('admins').child(auth.uid).exists())"
      }
    },

    "articles": {
      ".read": "auth != null",
      "$articleId": {
        ".write": "auth != null && (auth.token.email == 'beyondnow.ng@gmail.com' || root.child('admins').child(auth.uid).exists())"
      }
    },

    "admins": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.token.email == 'beyondnow.ng@gmail.com' || root.child('admins').child(auth.uid).exists())"
      }
    },

    "users": {
      ".read": "auth != null && (auth.token.email == 'beyondnow.ng@gmail.com' || root.child('admins').child(auth.uid).exists())",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.token.email == 'beyondnow.ng@gmail.com' || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid == $uid || auth.token.email == 'beyondnow.ng@gmail.com' || root.child('admins').child(auth.uid).exists())",

        "role": {
          ".validate": "(auth.token.email == 'beyondnow.ng@gmail.com' || root.child('admins').child(auth.uid).exists()) || (!data.exists() && newData.val() == 'user') || newData.val() == data.val()"
        },
        "status": {
          ".validate": "(auth.token.email == 'beyondnow.ng@gmail.com' || root.child('admins').child(auth.uid).exists()) || (!data.exists() && newData.val() == 'active') || newData.val() == data.val()"
        },
        "uid": {
          ".validate": "newData.val() == $uid"
        }
      }
    },

    "threads": {
      ".read": "auth != null && (auth.token.email == 'beyondnow.ng@gmail.com' || root.child('admins').child(auth.uid).exists())",

      "$threadId": {
        ".read": "auth != null && (auth.uid == $threadId || auth.token.email == 'beyondnow.ng@gmail.com' || root.child('admins').child(auth.uid).exists())",

        "meta": {
          ".write": "auth != null && (auth.uid == $threadId || auth.token.email == 'beyondnow.ng@gmail.com' || root.child('admins').child(auth.uid).exists())",
          "userId": {
            ".validate": "newData.val() == $threadId"
          }
        },

        "messages": {
          "$messageId": {
            ".write": "auth != null && ((auth.uid == $threadId && !data.exists()) || auth.token.email == 'beyondnow.ng@gmail.com' || root.child('admins').child(auth.uid).exists())",
            ".validate": "newData.hasChildren(['senderUid', 'senderRole', 'text', 'createdAt'])",

            "senderUid": {
              ".validate": "newData.val() == auth.uid"
            },
            "senderRole": {
              ".validate": "(newData.val() == 'user' && auth.uid == $threadId) || (newData.val() == 'admin' && (auth.token.email == 'beyondnow.ng@gmail.com' || root.child('admins').child(auth.uid).exists()))"
            },
            "threadId": {
              ".validate": "newData.val() == $threadId"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000"
            },
            "createdAt": {
              ".validate": "newData.isNumber()"
            }
          }
        }
      }
    }
  }
}
