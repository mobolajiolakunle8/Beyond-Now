rules_version = '2';

// =============================================================================
// BEYOND NOW — Cloud Storage security rules
// Deploy: firebase deploy --only storage
//
//   /media/**          CMS media library         public read · admin write
//   /avatars/{uid}/**  member profile pictures   public read · owner/admin write
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && (
        ('isAdmin' in request.auth.token && request.auth.token.isAdmin == true) ||
        ('email' in request.auth.token && request.auth.token.email.lower() == 'beyondnow.ng@gmail.com') ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
      );
    }
    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && request.resource.size < 15 * 1024 * 1024;
    }

    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if (isAdmin() || (signedIn() && request.auth.uid == userId))
        && isImage()
        && request.resource.size < 5 * 1024 * 1024;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
    }
  }
}
