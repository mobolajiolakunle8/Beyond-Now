rules_version = '2';

// BEYOND NOW — Cloud Storage security rules
// Deploy: firebase deploy --only storage
//
// Buckets:
//   /media/**           CMS media library (admin-only write)
//   /avatars/{uid}/**   user profile pictures (owner or admin write)
//   /articles/**        admin-managed article assets

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.isAdmin == true;
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // CMS media — public read, admin-only write
    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && request.resource.size < 15 * 1024 * 1024;
    }

    // User avatars — public read, owner or admin write
    match /avatars/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if (isOwner(uid) || isAdmin())
        && isImage()
        && request.resource.size < 5 * 1024 * 1024;
    }

    // Article attachments
    match /articles/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 15 * 1024 * 1024;
    }
  }
}
