rules_version = '2';

// =============================================================================
// BEYOND NOW — Cloud Firestore security rules
// Deploy: firebase deploy --only firestore:rules
//
// Identity model:
//   - Administrator: request.auth.token.isAdmin == true, OR
//                    email == 'beyondnow.ng@gmail.com', OR
//                    document exists at /databases/$(database)/documents/admins/$(uid)
//   - Member: Any signed-in user
//   - Public: Read-only access to published website content and media
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function authEmail() {
      return request.auth.token.get('email', '');
    }
    function isRootAdmin() {
      return signedIn() && (
        authEmail() == 'beyondnow.ng@gmail.com' ||
        authEmail().lower() == 'beyondnow.ng@gmail.com'
      );
    }
    function isAdmin() {
      return signedIn() && (
        isRootAdmin() ||
        request.auth.token.get('isAdmin', false) == true ||
        exists(/databases/$(database)/documents/admins/$(uid()))
      );
    }
    function isSelf(id) {
      return signedIn() && uid() == id;
    }

    // ------------------------------------------------- Website Content (CMS)
    // Public read for website visitors; write permitted for administrators.
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Media library metadata
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Articles for authenticated users
    match /articles/{articleId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ------------------------------------------------- Admin Allow-List
    match /admins/{adminId} {
      allow read: if signedIn();
      allow write: if isRootAdmin() || isAdmin();
    }

    // ------------------------------------------------- Member Profiles
    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      
      // User can create their own profile upon signing up
      allow create: if isSelf(userId);

      // User can update their own profile; admins can update any profile
      allow update: if isSelf(userId) || isAdmin();
      
      allow delete: if isAdmin();

      // Bookmarked resources
      match /saved/{itemId} {
        allow read, write: if isSelf(userId) || isAdmin();
      }

      // Notifications
      match /notifications/{itemId} {
        allow read, write: if isSelf(userId) || isAdmin();
      }
    }

    // ------------------------------------------------- Chat Threads
    // Thread ID is the member's uid (one private thread per user)
    match /threads/{threadId} {
      allow read: if isSelf(threadId) || isAdmin();
      allow create: if isSelf(threadId) || isAdmin();
      allow update: if isSelf(threadId) || isAdmin();
      allow delete: if isAdmin();

      // Messages inside the thread
      match /messages/{messageId} {
        allow read: if isSelf(threadId) || isAdmin();
        
        // Members can create messages in their own thread; Admins can create in any thread
        allow create: if signedIn() && (
          (isSelf(threadId) && request.resource.data.senderUid == uid()) ||
          isAdmin()
        );
        
        allow update, delete: if isAdmin();
      }
    }
  }
}
