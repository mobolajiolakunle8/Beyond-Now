rules_version = '2';

// =============================================================================
// BEYOND NOW — Cloud Firestore security rules
// Deploy: firebase deploy --only firestore:rules
//
// Identity model:
//   - Root Administrator: email matches beyondnow.ng@gmail.com
//   - Delegated Administrator: document exists in admins/{uid} OR custom claim isAdmin == true
//   - Authenticated Member: any signed-in user
//   - Public: unauthenticated visitor (read-only for live website CMS content)
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(id) {
      return isSignedIn() && request.auth.uid == id;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email == 'beyondnow.ng@gmail.com') ||
        ('isAdmin' in request.auth.token && request.auth.token.isAdmin == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // -------------------------------------------------------------------------
    // 1. Website Content (CMS) — Public can read; only Admins can write
    // -------------------------------------------------------------------------
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 2. Media Library Metadata — Public can read; only Admins can write
    // -------------------------------------------------------------------------
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 3. Articles — Signed-in users can read; only Admins can write
    // -------------------------------------------------------------------------
    match /articles/{articleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 4. Admin Allow-List — Read by self or admin; write by self (bootstrap) or admin
    // -------------------------------------------------------------------------
    match /admins/{adminId} {
      allow read: if isSelf(adminId) || isAdmin();
      allow write: if isSelf(adminId) || isAdmin();
    }

    // -------------------------------------------------------------------------
    // 5. User Profiles & Sub-collections (Saved, Notifications)
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create, update: if isSelf(userId) || isAdmin();
      allow delete: if isAdmin();

      // Bookmarked resources
      match /saved/{itemId} {
        allow read, write: if isSelf(userId) || isAdmin();
      }

      // In-app notifications
      match /notifications/{itemId} {
        allow read, write: if isSelf(userId) || isAdmin();
      }
    }

    // -------------------------------------------------------------------------
    // 6. Private Conversations (Threads & Messages)
    //    One thread per user: threads/{userId}
    // -------------------------------------------------------------------------
    match /threads/{threadId} {
      allow read: if isSelf(threadId) || isAdmin();
      allow create, update: if isSelf(threadId) || isAdmin();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSelf(threadId) || isAdmin();
        allow create: if isSelf(threadId) || isAdmin();
        allow update, delete: if isAdmin();
      }
    }
  }
}
